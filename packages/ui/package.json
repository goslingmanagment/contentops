{
  "name": "@contentops/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./globals.css": "./src/globals.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p gallery/tsconfig.json",
    "gallery:dev": "vite --config gallery/vite.config.ts",
    "gallery:build": "vite build --config gallery/vite.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@contentops/contracts": "workspace:*"
  }
}
