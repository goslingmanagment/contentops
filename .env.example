# ContentOps stack settings (SPEC §12.1). Copy to .env next to docker-compose.yml, fill the
# secrets, `chmod 600 .env`; ops/up.sh refuses another mode. Never commit .env.
# Passwords go into connection URLs: use [0-9a-f] only, e.g. `openssl rand -hex 24`.

# --- Address ------------------------------------------------------------------
# What people open. Pilot: `tailscale serve` HTTP (tailnet HTTPS certificates are off, owner's
# decision pending); https:// here makes session cookies Secure.
PUBLIC_URL=http://contentops.tail1d911a.ts.net
# Host port of nginx, loopback only (`tailscale serve` points to it).
PROXY_PORT=8080
# Docker network of the stack; nginx and loopback (tailscaled) may set X-Forwarded-*.
STACK_SUBNET=10.77.10.0/24

# --- Database (secrets) -------------------------------------------------------
POSTGRES_PASSWORD=
MIGRATE_DB_PASSWORD=
APP_DB_PASSWORD=

# --- Storage roots on the host (ext4 only; SPEC §12.1–12.2) --------------------
DATA_ROOT=/srv/content
DB_ROOT=/srv/db
DERIVED_ROOT=/srv/derived
TMP_ROOT=/srv/tmp
# Must be mount points on the host before the workers start (ops/up.sh, `mountpoint -q`).
# Empty on a host without separate disks.
REQUIRE_HOST_MOUNTS=/srv/content,/srv/db,/srv/derived,/srv/tmp
# Free space of the host disks written by Windows (ops/winpc/ContentOps-Space.ps1), mounted
# read-only (ops/vm/setup-host-share.sh). Pilot thresholds: warn 200 GB, stop intake 100 GB.
HOST_SHARE=/mnt/host
# The local Я.Диск copy for the old corpus (cifs ro, ops/README.md «Что не трогать»).
LEGACY_COPY=/mnt/ydisk
SPACE_WARN_GB=200
SPACE_STOP_GB=100
# Propagation of the automounted shares above; rprivate only for a local stack on Docker
# Desktop, which has no rslave (ops/README.md «Проверки стека»).
# MOUNT_PROPAGATION=rslave

# --- Background work (SPEC §12.0 «Производительность», §12.2) -------------------
# ENCODE_JOBS=2 only after the VM has 22 GB (ops/README.md «Память»).
ENCODE_JOBS=1
SVTAV1_LP=4
COPY_JOBS=1
FETCH_JOBS=4
FETCH_AHEAD_GB=25
IMAGE_JOBS=2
# CPU quotas of the heavy workers: one core always stays free for web (16 vCPU in the VM).
VIDEO_CPUS=11
IMAGE_CPUS=4

# --- Integrations: empty = not configured (the app starts without them, SPEC §8) -----------
# Yandex Disk: OAuth token with `cloud_api:disk.read` only.
YDISK_TOKEN=
# Dropbox: refresh token of the read-only app (scopes files.metadata.read, files.content.read).
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
HUB_BASE_URL=
HUB_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Smoke checks (ops/smoke.sh, PLAN 6) ------------------------------------------
# Token of the smoke agent: `ops/smoke.sh --setup --token` prints it once. Only ops/smoke.sh
# reads it; no service gets it.
SMOKE_TOKEN=

LOG_LEVEL=info
